# NeuroVision AI — STAGING environment template. Contains NO real secrets.
# Real secret VALUES must be injected at deploy time (env or a mounted secrets file
# referenced by NV_SECRETS_FILE) and must NEVER be committed.
NV_ENV=staging
NV_WORKSPACE_DIR=/var/lib/neurovision/workspace
NV_BACKUP_DIR=/var/lib/neurovision/backups
NV_LOG_LEVEL=info
NV_LOG_FORMAT=json
NV_METRICS_ENABLED=true
NV_PBKDF2_ITERATIONS=200000
NV_MODEL_ARCHITECTURE=eegnet
# Required secrets (names only — inject real values out-of-band):
# NV_SECRETS_FILE=/run/secrets/neurovision.env
NV_AUTH_SECRET_KEY=__INJECT_AT_DEPLOY__
NV_ADMIN_BOOTSTRAP_PASSWORD=__INJECT_AT_DEPLOY__
