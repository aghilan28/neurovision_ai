# NeuroVision AI — DEVELOPMENT environment template.
# Copy to a local .env (gitignored) and adjust. Contains NO real secrets.
NV_ENV=development
NV_WORKSPACE_DIR=./.nv_runtime
NV_BACKUP_DIR=./.nv_backups
NV_LOG_LEVEL=debug
NV_LOG_FORMAT=json
NV_METRICS_ENABLED=true
NV_PBKDF2_ITERATIONS=200000
NV_MODEL_ARCHITECTURE=eegnet
# No secrets are required in development (auth uses secure defaults locally).
# NV_AUTH_SECRET_KEY=
# NV_ADMIN_BOOTSTRAP_PASSWORD=
